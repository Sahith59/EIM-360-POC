# Copy this file to .env (same folder as package.json) and fill in ONE provider.
# .env is git-ignored: never commit or share your key.

# Which LLM the AI test agent uses: gemini | anthropic | openai | azure | local | off
LLM_PROVIDER=gemini
# Optional: override the provider's default model
# LLM_MODEL=gemini-3.5-flash

# Google Gemini  (key from https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Anthropic Claude
ANTHROPIC_API_KEY=

# OpenAI
OPENAI_API_KEY=

# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_API_VERSION=2024-10-21

# Local or any OpenAI-compatible server (Ollama, LM Studio, vLLM, OpenRouter, Groq ...)
# LOCAL_LLM_BASE_URL=http://localhost:11434/v1
# LOCAL_LLM_MODEL=llama3.1
# LOCAL_LLM_API_KEY=

# Tuning (optional)
# LLM_CONCURRENCY=3
# LLM_TIMEOUT_MS=60000
